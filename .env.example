# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret

# SQLite local (Railway uses file:/app/data/maisonora.db)
DATABASE_URL=file:./data/maisonora.db

# Compte autorisé à valider les avis (virgules si plusieurs)
ADMIN_EMAIL=contact@francemobilier.com

# Store flags
STORE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STORE_CHECKOUT_ENABLED=false

# Stripe — les clés sk_test_ / pk_test_ ouvrent le checkout en test.
# Le live (sk_live_) reste fermé tant que STORE_CHECKOUT_ENABLED n’est pas true.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Confirmation de commande (Resend et/ou SMTP). Stripe test n’envoie pas d’e-mail.
RESEND_API_KEY=
MAIL_FROM=France Mobilier <contact@francemobilier.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# BuckyDrop OpenAPI (do not invent endpoints)
BUCKYDROP_ENABLED=false
BUCKYDROP_ENV=sandbox
BUCKYDROP_APP_CODE=
BUCKYDROP_APP_SECRET=
BUCKYDROP_API_BASE_URL=

# Google Merchant
GOOGLE_MERCHANT_FEED_ENABLED=false
